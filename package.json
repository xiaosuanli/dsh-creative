{
  "name": "@xiaosuanli/dsh-plugin",
  "version": "1.0.1",
  "type": "module",
  "description": "让用户在 DeepSeek Harness（DSH）中通过自然语言对话生成、修改并导出 AI 视频，支持故事/小说转视频与参考视频复刻。",
  "engines": {
    "node": ">=22.19.0",
    "dsh": "0.2.1-rc.2"
  },
  "exports": {
    ".": "./host.mjs",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "files": [
    "host.mjs",
    "client.js",
    "src/connect",
    "skills",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "release": "node scripts/release.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaosuanli/dsh-creative.git"
  },
  "homepage": "https://github.com/xiaosuanli/dsh-creative#readme",
  "bugs": {
    "url": "https://github.com/xiaosuanli/dsh-creative/issues"
  },
  "author": "Xiaosuanli",
  "license": "UNLICENSED",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "xiaosuanli",
    "ai-video",
    "video-generation",
    "conversational-video",
    "text-to-video",
    "novel-to-video",
    "video-remake",
    "视频生成",
    "小说转视频",
    "视频复刻"
  ]
}
